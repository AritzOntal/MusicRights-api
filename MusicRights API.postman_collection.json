      "item": [
        {
          "name": "addMusician",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Estructura de respuesta y valores con correctos\", () => {",
                  "    pm.expect(pm.response.json()).to.have.property(\"id\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"firstName\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"birthDate\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"affiliated\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"dni\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"performanceFee\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"affiliatedNumber\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"works\");",
                  "",
                  "    var jsonData = pm.response.json();",
                  "",
                  "    pm.expect(jsonData.firstName).to.eql(\"Aritz\");",
                  "    pm.expect(jsonData.lastName).to.eql(\"Ontalvilla\");",
                  "    pm.expect(jsonData.affiliated).to.eql(true);",
                  "    pm.expect(jsonData.birthDate).to.eql(\"1992-12-09\");",
                  "    pm.expect(jsonData.dni).to.eql(\"12345678J\");",
                  "    pm.expect(jsonData.performanceFee).to.eql(6.0);",
                  "    pm.expect(jsonData.affiliatedNumber).to.eql(6666);",
                  "    pm.expect(jsonData.works).to.eql([]);",
                  "",
                  "    pm.collectionVariables.set(\"musician_id\", jsonData.id)",
                  "})"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
